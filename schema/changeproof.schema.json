{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ChangeProof configuration",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "policies"],
  "properties": {
    "$schema": { "type": "string" },
    "version": { "const": 1 },
    "policies": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/policy" }
    }
  },
  "$defs": {
    "globList": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1,
        "pattern": "^(?!\\!).+"
      }
    },
    "policy": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "when", "require"],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9-]*$"
        },
        "description": { "type": "string", "minLength": 1 },
        "severity": {
          "type": "string",
          "enum": ["error", "warning"],
          "default": "error"
        },
        "message": { "type": "string", "minLength": 1 },
        "when": {
          "type": "object",
          "additionalProperties": false,
          "required": ["changed"],
          "properties": {
            "changed": { "$ref": "#/$defs/globList" },
            "ignore": { "$ref": "#/$defs/globList" }
          }
        },
        "require": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "any": { "$ref": "#/$defs/globList" },
            "all": { "$ref": "#/$defs/globList" }
          },
          "anyOf": [
            { "required": ["any"] },
            { "required": ["all"] }
          ]
        }
      }
    }
  }
}
